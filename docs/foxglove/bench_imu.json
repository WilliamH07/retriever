{
  "configById": {
    "3D!bench": {
      "cameraState": {
        "distance": 2.5,
        "perspective": true,
        "phi": 60,
        "thetaOffset": 45,
        "targetOffset": [0, 0, 0],
        "target": [0, 0, 0],
        "targetOrientation": [0, 0, 0, 1],
        "fovy": 45,
        "near": 0.01,
        "far": 5000
      },
      "followMode": "follow-pose",
      "followTf": "imu_world",
      "scene": { "enableStats": false, "transforms": { "showLabel": true, "axisScale": 0.5 } },
      "transforms": {},
      "topics": {
        "/retriever/imu_marker": { "visible": true }
      },
      "layers": {
        "grille": { "layerId": "foxglove.Grid", "visible": true, "size": 2, "divisions": 20 }
      }
    },

    "Plot!gyro": {
      "title": "Vitesse angulaire (rad/s)",
      "paths": [
        { "value": "/imu/data.angular_velocity.x", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/imu/data.angular_velocity.y", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/imu/data.angular_velocity.z", "enabled": true, "timestampMethod": "receiveTime" }
      ],
      "showLegend": true,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 20
    },

    "Plot!accel": {
      "title": "Acceleration, gravite comprise (m/s2)",
      "paths": [
        { "value": "/imu/data.linear_acceleration.x", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/imu/data.linear_acceleration.y", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/imu/data.linear_acceleration.z", "enabled": true, "timestampMethod": "receiveTime" }
      ],
      "showLegend": true,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 20
    },

    "DiagnosticSummary!diag": {
      "minLevel": 0,
      "pinnedIds": [],
      "hardwareIdFilter": "",
      "topicToRender": "/diagnostics",
      "sortByLevel": true
    },

    "RawMessages!imu": { "topicPath": "/retriever/imu_status" },

    "RawMessages!link": { "topicPath": "/retriever/link_status" }
  },

  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": { "speed": 1 },

  "layout": {
    "direction": "row",
    "splitPercentage": 55,
    "first": {
      "direction": "column",
      "splitPercentage": 62,
      "first": "3D!bench",
      "second": "DiagnosticSummary!diag"
    },
    "second": {
      "direction": "column",
      "splitPercentage": 34,
      "first": "Plot!gyro",
      "second": {
        "direction": "column",
        "splitPercentage": 50,
        "first": "Plot!accel",
        "second": {
          "direction": "column",
          "splitPercentage": 50,
          "first": "RawMessages!imu",
          "second": "RawMessages!link"
        }
      }
    }
  }
}
