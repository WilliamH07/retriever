# ROS 2 / colcon
# Anchored on purpose: an unanchored "build/" matches ANY directory named
# build at any depth, which silently swallowed docs/images/build.
/build/
/install/
/log/
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
.colcon*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# C / C++
*.o
*.a
*.so
*.elf
*.bin.tmp

# PlatformIO / ESP-IDF
.pio/
.pioenvs/
.piolibdeps/
sdkconfig.old

# EasyEDA and PCB output
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
fp-info-cache

# CAD autosave
*.FCStd1
*.f3d.bak
~$*

# Bag files and logs, large and not source
*.mcap
*.db3
bags/
*.log

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
