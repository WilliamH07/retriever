<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>retriever_bringup</name>
  <version>0.1.0</version>
  <description>
    Point d'entrée unique : fichiers de lancement et configuration système.
    Aujourd'hui, un seul banc — bench_imu.launch.py. Le lancement complet du
    robot viendra ici, avec ses arguments, quand il y aura un robot à lancer.
  </description>
  <maintainer email="wcontact33@gmail.com">William Hanczyk</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>retriever_link</exec_depend>
  <exec_depend>retriever_msgs</exec_depend>
  <!-- Optionnel : le banc se lance avec foxglove:=false sans ce paquet. -->
  <exec_depend>foxglove_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
